java_library {
    name: "libccplugin_islet_realm",
    srcs: [ "src/**/*.java" ],
    static_libs: [
        "android.system.virtualization.payload-java",
    ]
}

droiddoc {
    name: "libccplugin_islet_realm-doc",
    srcs: [
        "src/**/*.java",
        ":android.system.virtualization.payload.provisioning-src",
    ],
    custom_template: "metalava-manual",
    visibility: ["//visibility:public"],
}
