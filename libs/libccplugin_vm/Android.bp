java_library_static {
    name: "libccplugin_vm",
    srcs: ["java/com/islet/binder/service/VmManager.java"],
    static_libs: [
        "ccplugin_aidl-java",
        "libccplugin_log",
    ],
    sdk_version: "system_current"
}

droiddoc {
    name: "libccplugin_vm-doc",
    srcs: ["java/**/*.java"],
    libs: [
        "ccplugin_aidl-java",
        "libccplugin_log",
    ],
    sdk_version: "system_current",
    custom_template: "metalava-manual",
    visibility: ["//visibility:public"],
}
